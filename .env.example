# AI Video System - Environment Variables
# Copy this file to .env and fill in your keys
# cp .env.example .env

# OpenAI API Key (for AI script generation)
# Get from: https://platform.openai.com/api-keys
# Optional - system works in demo mode without this
OPENAI_API_KEY=your_openai_api_key_here

# YouTube API Key (for video uploads)
# Get from: Google Cloud Console > APIs > YouTube Data API v3
# Optional - system works without this (videos saved locally)
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth Client Secrets File (for uploads)
# Download from Google Cloud Console > Credentials > OAuth 2.0 Client ID
# Save the JSON file and put its path here
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# YouTube Channel ID (optional - for tracking)
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Video Settings (optional - defaults in config.py)
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# VIDEO_FPS=24
